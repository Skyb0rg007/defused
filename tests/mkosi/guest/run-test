"""Run one test inside the VM and take the machine down with its result.

$DEFUSED_TEST names the test, which the host runner puts on the kernel
command line with systemd.setenv=. The result line below is what the runner
reads off the console; the exit status handed to `systemctl exit` only
reaches the host when the VM has a vsock.
"""

import importlib.util
import os
import subprocess
import sys
import time
import traceback

TESTDIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, TESTDIR)
sys.path.insert(0, os.path.join(TESTDIR, "tests"))

BEGIN = "DEFUSED-TEST-BEGIN:"
RESULT = "DEFUSED-TEST-RESULT:"


def load(name):
    """Import the test module of that name, chosen from what is installed.

    The name arrives from the kernel command line, so the file to import is
    picked out of the directory listing rather than built from it.
    """
    tests = os.path.join(TESTDIR, "tests")
    available = sorted(f for f in os.listdir(tests) if f.endswith(".py"))
    for entry in available:
        if entry[: -len(".py")] == name:
            spec = importlib.util.spec_from_file_location(
                f"defused_test_{entry}", os.path.join(tests, entry)
            )
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            return module
    raise SystemExit(f"no such test: {name!r} (have: {', '.join(available)})")


def power_off(status):
    """`systemctl exit` powers the VM off and reports the status over vsock."""
    for cmd in (["systemctl", "exit", str(status)], ["systemctl", "poweroff", "-ff"]):
        subprocess.run(cmd, check=False)
        time.sleep(15)
    os.sync()
    subprocess.run(["reboot", "-ff"], check=False)


def main():
    name = os.environ.get("DEFUSED_TEST") or (sys.argv[1] if len(sys.argv) > 1 else "")
    if not name:
        raise SystemExit("no test named in $DEFUSED_TEST")
    harness = None

    print(f"{BEGIN} {name}", flush=True)
    try:
        module = load(name)
        harness = sys.modules.get("harness")
        module.run()
    except BaseException:  # noqa: BLE001 -- the result line is the report
        traceback.print_exc()
        if harness is not None:
            try:
                harness.diagnose()
            except Exception:  # noqa: BLE001
                traceback.print_exc()
        sys.stdout.flush()
        sys.stderr.flush()
        print(f"{RESULT} FAIL {name}", flush=True)
        return 1
    print(f"{RESULT} PASS {name}", flush=True)
    return 0


if __name__ == "__main__":
    status = main()
    sys.stdout.flush()
    power_off(status)
