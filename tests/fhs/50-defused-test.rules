// For the test suite only: there is no session or agent in CI to answer an
// interactive polkit prompt, so allow every defused action outright, as the
// NixOS VM tests do. A real deployment wants a real policy -- see
// packaging/polkit/examples/50-defused-mount-policy.rules.
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("website.soss.defused.") == 0) {
        return polkit.Result.YES;
    }
});
