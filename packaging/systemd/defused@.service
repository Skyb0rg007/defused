[Unit]
Description=defused FUSE mount service (%i)
Documentation=https://github.com/Skyb0rg007/defused
Wants=polkit.service
After=polkit.service

[Service]
ExecStart=/usr/lib/defused/defused
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_SYS_PTRACE
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_SYS_PTRACE
NoNewPrivileges=yes
AppArmorProfile=-defused

LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectHostname=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

# No [Install] section: this is a template unit instantiated per-connection
# by defused.socket's Accept=yes -- it's never enabled/started directly, so
# there's nothing for [Install] to attach to. Enable/start defused.socket
# instead (see its own [Install] section).
