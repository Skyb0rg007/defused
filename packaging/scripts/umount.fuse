#!/bin/sh
#
# SPDX-FileCopyrightText: 2026 Skye Soss <skye@soss.website>
#
# SPDX-License-Identifier: MIT-0

set -eu

usage() {
    echo "usage: $0 <mountpoint> [-nlfvr] [-t <type.subtype>] [-N <nspath>]"
    exit 1
} >&2

[ $# -ge 1 ] || usage

prog=${0##*/}
mountpoint=$1; shift
force=
lazy=
verbose=
namespace=

while getopts ":nlfvrt:N:" arg; do
    case $arg in
        n|r|t) ;;
        f)  force=1;;
        l)  lazy=1;;
        N)  namespace="$OPTARG";;
        v)  verbose=1;;
        *)  echo >&2 "$prog: unrecognized option $OPTARG"; usage;;
    esac
done

shift $((OPTIND - 1))
[ "$#" -eq 0 ] || usage

if [ -n "$force" ]; then
    high=$(stat --cached always --format '%Hd' -- "$mountpoint")
    low=$(stat --cached always --format '%Ld' -- "$mountpoint")
    conn=$(( (high << 20) | low ))
    if ! [ -d "/sys/fs/fuse/connections/$conn" ]; then
        echo >&2 "$prog: $mountpoint is not a FUSE mount"
        exit 1
    fi
    [ -z "$verbose" ] || echo >&2 "$prog: aborting FUSE connection $conn"
    echo 1 > "/sys/fs/fuse/connections/$conn/abort"
fi

fusermount_args=
if [ "$lazy" = 1 ]; then
    fusermount_args="-z"
fi

if [ -n "$namespace" ]; then
    [ -z "$verbose" ] || echo >&2 "$prog: nsenter --mount=\"$namespace\" -- fusermount3 -u $fusermount_args -- \"$mountpoint\""
    nsenter --mount="$namespace" -- fusermount3 -u $fusermount_args -- "$mountpoint"
else
    [ -z "$verbose" ] || echo >&2 "$prog: fusermount3 -u $fusermount_args -- \"$mountpoint\""
    fusermount3 -u $fusermount_args -- "$mountpoint"
fi
[ -z "$verbose" ] || echo >&2 "umount: $mountpoint unmounted"
