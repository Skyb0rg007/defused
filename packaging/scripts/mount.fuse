#!/bin/sh
#
# SPDX-FileCopyrightText: 2026 Skye Soss <skye@soss.website>
#
# SPDX-License-Identifier: MIT-0

set -eu

usage() {
    echo "usage: $0 <type#source|source> <mountpoint> [-sfnv] [-o <options>] [-t <type.subtype>] [-N <nspath>]"
    exit 1
} >&2

[ $# -ge 2 ] || usage

prog=${0##*/}
source=$1; mountpoint=$2; shift 2
type=
fake=
verbose=
namespace=
options=

while getopts "sfnvo:t:N:" arg; do
    case $arg in
        s|n) ;;
        f)  fake=1;;
        o)  options=$OPTARG;;
        t)  type=$OPTARG;;
        N)  namespace=$OPTARG;;
        v)  verbose=1;;
        *)  usage;;
    esac
done
shift $((OPTIND - 1))
[ $# -eq 0 ] || usage

case $type in
    fuse.?*|fuseblk.?*) type=${type#*.};;
    *)  # No subtype: fstab's older "type#source" form.
        type=${source%%#*}
        source=${source#"$type"}
        source=${source#\#}
        ;;
esac
if [ -z "$type" ]; then
    echo >&2 "$prog: empty filesystem type"
    exit 1
fi

# Like libfuse's mount.fuse3: default to dev and suid as mount(8) does
# (a later nodev or nosuid wins), and drop the options meant for mount(8).
fsopts=dev,suid
setuid=
set -f; IFS=,
for opt in $options; do
    case $opt in
        setuid=*) setuid=${opt#setuid=};;
        drop_privileges)
            echo >&2 "$prog: drop_privileges is not supported"
            exit 1
            ;;
        ""|user|nouser|users|auto|noauto|nofail|_netdev) ;;
        *)  fsopts=$fsopts,$opt;;
    esac
done
unset IFS; set +f

# Filesystems started at boot may otherwise have no HOME; runuser sets its own.
export HOME="${HOME-/root}"

set -- "$type" ${source:+"$source"} "$mountpoint" -o "$fsopts"
[ -z "$setuid" ] || set -- runuser -u "$setuid" -- "$@"
[ -z "$namespace" ] || set -- nsenter --mount="$namespace" -- "$@"
[ -z "$verbose" ] || echo >&2 "$prog: $*"
[ -z "$fake" ] || exit 0
exec "$@"
